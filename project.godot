; Engine configuration file.
config_version=5

[application]
config/name="Flightcraft"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="A relaxing procedural voxel-world exploration prototype."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.39, 0.62, 0.78, 1)

[input]
move_forward={"deadzone":0.2,"events":[{"physical_keycode":87}]}
move_back={"deadzone":0.2,"events":[{"physical_keycode":83}]}
move_left={"deadzone":0.2,"events":[{"physical_keycode":65}]}
move_right={"deadzone":0.2,"events":[{"physical_keycode":68}]}
jump={"deadzone":0.2,"events":[{"physical_keycode":32}]}
run={"deadzone":0.2,"events":[{"physical_keycode":4194325}]}
toggle_flight={"deadzone":0.2,"events":[{"physical_keycode":70}]}
pause={"deadzone":0.2,"events":[{"physical_keycode":4194305}]}
